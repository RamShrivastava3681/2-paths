[TEMPLATE]
# ===========================================================================
# Two Paths Platform — Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=7979
APP_URL=http://localhost:3000

# ── AWS / DynamoDB ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DYNAMODB_TABLE=InsightFactor
# Uncomment for local DynamoDB (e.g. dynamodb-local):
# DYNAMODB_ENDPOINT=http://localhost:8000

# ── S3 ─────────────────────────────────────────────────────────────────────────
S3_BUCKET=
S3_BUCKET_REGION=

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=auth_token
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Designated super admin — the only account allowed to create/delete users,
# manage roles and view other users' last-seen/IP-location.
# Defaults to ADMIN_EMAIL when unset.
SUPER_ADMIN_EMAIL=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (production only).
# Localhost origins are auto-allowed in development mode.
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ── SMTP / Email ───────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── E-Way Bill (Direct NIC API — v1.03) ────────────────────────────────────────
# Direct taxpayer → NIC E-Way Bill System integration.
# Credentials are stored per-GSTIN in the database (encrypted at rest).
# Only the following environment variables are needed:
#
# EWB_API_ENV          "sandbox" | "preproduction" | "production"
# EWB_API_PUBLIC_KEY   NIC EWB public key (PEM format) for encrypting auth credentials
# EWB_CREDENTIAL_ENCRYPTION_KEY  Hex-encoded 32-byte key for encrypting credentials at rest
#
# To configure E-Way Bill API credentials:
#   1. Register on the E-Way Bill portal (https://ewaybill.nic.in)
#   2. Enable API access (Registration → For API)
#   3. Obtain Client ID and Client Secret from the portal
#   4. Configure credentials in the UI: Settings → E-Way Bill Configuration
#
EWB_API_ENV=sandbox
EWB_API_PUBLIC_KEY=
EWB_CREDENTIAL_ENCRYPTION_KEY=
